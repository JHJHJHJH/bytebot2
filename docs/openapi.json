  "info": {
    "title": "Bytebot Agent API",
    "description": "REST API for managing Bytebot agent tasks and models",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [
    {
      "name": "tasks",
      "description": "Create, run, and inspect agent tasks"
    },
    {
      "name": "model-keys",
      "description": "Configure LLM provider API keys"
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "TaskFileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "base64": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "size": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "base64",
          "type",
          "size"
        ]
      },
      "CreateTaskDto": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "IMMEDIATE",
              "SCHEDULED"
            ]
          },
          "scheduledFor": {
            "format": "date-time",
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "URGENT"
            ]
          },
          "createdBy": {
            "type": "string",
            "enum": [
              "USER",
              "ASSISTANT"
            ]
          },
          "model": {
            "type": "object"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskFileDto"
            }
          }
        },
        "required": [
          "description"
        ]
      },
      "AddTaskMessageDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      }
    }
  }
}